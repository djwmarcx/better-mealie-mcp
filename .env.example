# Better Mealie MCP configuration. Copy to `.env` and fill in.

# Base URL of your Mealie instance (no trailing /api).
MEALIE_BASE_URL=http://localhost:9925

# --- Auth: pick ONE method ---

# (Preferred) Long-lived API token. Create in Mealie:
#   Profile -> Manage API Tokens -> Generate.
MEALIE_API_TOKEN=

# (Alternative) Username/password. Server logs in at startup to fetch a token.
# MEALIE_USERNAME=changeme@example.com
# MEALIE_PASSWORD=MyPassword

# --- Optional ---

# Per-request timeout, seconds.
# MEALIE_TIMEOUT=60

# Verify the Mealie server's TLS certificate. Set "false" to accept
# self-signed certs / hostname mismatch. Trusted networks only.
# MEALIE_VERIFY_SSL=true

# MCP server name advertised to clients.
# MCP_SERVER_NAME=Mealie

# --- HTTP endpoint auth (MCP_AUTH_MODE, no effect in stdio mode) ---
#
# Controls who may call the server over HTTP. STDIO always inherits its
# security from the local environment and ignores these.
#
#   none  — open endpoint (trusted/local setups only)
#   key   — every request must carry "Authorization: Bearer <token>"
#   oauth — run a built-in OAuth 2.1 authorization server (DCR + PKCE) so
#           clients like ChatGPT/Claude can use their "sign in" connector flow
#   both  — accept an OAuth access token OR the pre-shared API key
#
# Default is "none" — HTTP auth is opt-in. Merely setting MCP_AUTH_TOKEN has
# no effect unless the mode is "key" or "both".
# "key"/"both" use MCP_AUTH_TOKEN as the API key.
# "oauth"/"both" need MCP_PUBLIC_BASE_URL set to the public HTTPS URL of the
# server so OAuth discovery metadata and redirect URIs resolve correctly.
MCP_AUTH_MODE=none
# MCP_AUTH_TOKEN=change-me
# MCP_PUBLIC_BASE_URL=https://mcp.example.com
